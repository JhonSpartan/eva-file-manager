/* ==============================
   FileForge — Dark Industrial
   Base
   ============================== */

QWidget {
    background-color: #1b1f24;
    color: #d7dce2;
    font-size: 13px;
}

QMainWindow {
    background-color: #1b1f24;
}


/* ==============================
   Group boxes / panels
   ============================== */

QGroupBox {
    background-color: #23282f;

    border: 1px solid #343a43;
    border-radius: 4px;

    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;

    left: 10px;
    padding: 0 4px;

    color: #aeb7c2;
}

/* ==============================
   Buttons
   ============================== */

QPushButton {
    background-color: #2a3038;
    color: #d7dce2;

    border: 1px solid #3b434d;
    border-radius: 3px;

    padding: 6px 12px;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #323a44;
    border-color: #56616e;
}

QPushButton:pressed {
    background-color: #20252b;
    border-color: #687583;
}

QPushButton:disabled {
    background-color: #22272d;
    color: #666e78;
    border-color: #30363d;
}

/* ==============================
   Input fields
   ============================== */

QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    background-color: #181c21;
    color: #d7dce2;

    border: 1px solid #343c46;
    border-radius: 3px;

    padding: 5px 8px;
    min-height: 22px;

    selection-background-color: #3f6685;
    selection-color: #ffffff;
}

QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QComboBox:hover {
    border-color: #4b5663;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {
    border-color: #527b9d;
    background-color: #1c2127;
}

QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QComboBox:disabled {
    background-color: #20252a;
    color: #68717b;
    border-color: #30363d;
}

/* ==============================
   Trees / tables
   ============================== */

QTreeWidget,
QTableWidget {
    background-color: #181c21;
    alternate-background-color: #1d2228;
    color: #d7dce2;

    border: 1px solid #343c46;
    border-radius: 3px;

    gridline-color: #30363e;

    selection-background-color: #344f65;
    selection-color: #ffffff;
}

QTreeWidget::item,
QTableWidget::item {
    padding: 4px 6px;
}

QTreeWidget::item:hover,
QTableWidget::item:hover {
    background-color: #252c34;
}

QTreeWidget::item:selected,
QTableWidget::item:selected {
    background-color: #344f65;
    color: #ffffff;
}


/* ==============================
   Table headers
   ============================== */

QHeaderView::section {
    background-color: #252b32;
    color: #aeb7c2;

    border: none;
    border-right: 1px solid #343c46;
    border-bottom: 1px solid #343c46;

    padding: 6px 8px;
}

QHeaderView::section:hover {
    background-color: #2d343d;
}

/* ==============================
   Scrollbars
   ============================== */

QScrollBar:vertical {
    background-color: #181c21;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #3a424c;
    min-height: 28px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4a5562;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}


QScrollBar:horizontal {
    background-color: #181c21;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #3a424c;
    min-width: 28px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4a5562;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ==============================
   Sidebar
   ============================== */

QWidget#sideMenu {
    background-color: #171b20;

    border-right: 1px solid #30363d;
}

QWidget#sideMenu QPushButton {
    background-color: transparent;
    color: #aeb7c2;

    border: 1px solid transparent;
    border-radius: 3px;

    text-align: left;

    padding: 8px 12px;
}

QWidget#sideMenu QPushButton:hover {
    background-color: #252b32;
    color: #ffffff;

    border-color: #343c46;
}

QWidget#sideMenu QPushButton:pressed {
    background-color: #1f252b;
}

QWidget#sideMenu QPushButton:checked {
    background-color: #2b3d4d;
    color: #ffffff;

    border-color: #466781;
}


/* ==============================
   Checkboxes / radio buttons
   ============================== */

QCheckBox,
QRadioButton {
    color: #d7dce2;
    spacing: 8px;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 16px;
    height: 16px;

    background-color: #181c21;
    border: 1px solid #46515d;
}

QCheckBox::indicator {
    border-radius: 3px;
}

QRadioButton::indicator {
    border-radius: 8px;
}


/* Hover */

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: #5b6876;
    background-color: #20262d;
}


/* Checked */

QCheckBox::indicator:checked {
    background-color: #466781;
    border-color: #527b9d;
}

QRadioButton::indicator:checked {
    background-color: #5b87a8;
    border: 4px solid #20262d;
}


/* Disabled */

QCheckBox:disabled,
QRadioButton:disabled {
    color: #68717b;
}

QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled {
    background-color: #20252a;
    border-color: #30363d;
}


/* ==============================
   Progress bars
   ============================== */

QProgressBar {
    background-color: #181c21;
    color: #d7dce2;

    border: 1px solid #343c46;
    border-radius: 3px;

    min-height: 18px;

    text-align: center;
}

QProgressBar::chunk {
    background-color: #466781;
    border-radius: 2px;
}


/* ==============================
   Font
   ============================== */

QWidget {
    background-color: #1b1f24;
    color: #d7dce2;

    font-family: "Segoe UI";
    font-size: 13px;
}

QGroupBox::title {
    font-size: 13px;
    font-weight: 600;
}

QWidget#sideMenu QPushButton {
    font-size: 13px;
    font-weight: 500;
}
