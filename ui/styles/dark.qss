/* ==============================
   FileForge — Dark Industrial
   Base
   ============================== */

QWidget {
    background-color: #1b1f24;
    color: #d7dce2;
    font-family: "Segoe UI";
    font-size: 13px;
}

QMainWindow {
    background-color: #1b1f24;
}


/* ==============================
   Group boxes / panels
   ============================== */

QGroupBox {
    background-color: #23282f;

    border: 1px solid #343a43;
    border-radius: 4px;

    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;

    left: 10px;
    padding: 0 4px;

    color: #aeb7c2;
}

/* ==============================
   Buttons
   ============================== */

QPushButton {
    background-color: #2a3038;
    color: #d7dce2;

    border: 1px solid #3b434d;
    border-radius: 3px;

    padding: 6px 12px;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #323a44;
    border-color: #56616e;
}

QPushButton:pressed {
    background-color: #20252b;
    border-color: #687583;
}

QPushButton:disabled {
    background-color: #22272d;
    color: #666e78;
    border-color: #30363d;
}

/* ==============================
   SpinBox buttons
   ============================== */

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;

    width: 18px;

    background-color: #2a3038;
    border-left: 1px solid #3b434d;
    border-bottom: 1px solid #3b434d;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;

    width: 18px;

    background-color: #2a3038;
    border-left: 1px solid #3b434d;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #323a44;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(resources/icons/spin-up.svg);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(resources/icons/spin-down.svg);
    width: 10px;
    height: 10px;
}

/* ==============================
   Stopper buttons
   ============================== */

QPushButton#stopperButton {
    min-width: 50px;
    max-width: 50px;
    min-height: 50px;
    max-height: 50px;

    padding: 0px;

    background-color: #2a3038;
    color: #d7dce2;

    border: 2px solid #3b434d;
    border-radius: 25px;

    margin-right: 10px;
}

QPushButton#stopperButton:hover {
    background-color: #323a44;
    border-color: #56616e;
}

QPushButton#stopperButton:checked {
    background-color: #2b3d4d;
    color: #ffffff;

    border: 3px solid #466781;
}

/* ==============================
   Input fields
   ============================== */

QLineEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
    background-color: #181c21;
    color: #d7dce2;

    border: 1px solid #343c46;
    border-radius: 3px;

    padding: 5px 8px;
    min-height: 22px;

    selection-background-color: #3f6685;
    selection-color: #ffffff;
}

QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QComboBox:hover {
    border-color: #4b5663;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QComboBox:focus {
    border-color: #527b9d;
    background-color: #1c2127;
}

QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QComboBox:disabled {
    background-color: #20252a;
    color: #68717b;
    border-color: #30363d;
}

/* ==============================
   Trees / tables
   ============================== */

QTreeWidget,
QTableWidget {
    background-color: #181c21;
    alternate-background-color: #1d2228;
    color: #d7dce2;

    border: 1px solid #343c46;
    border-radius: 3px;

    gridline-color: #30363e;

    selection-background-color: #344f65;
    selection-color: #ffffff;
}

QTreeWidget::item,
QTableWidget::item {
    padding: 4px 6px;
}

QTreeWidget::item:hover,
QTableWidget::item:hover {
    background-color: #252c34;
}

QTreeWidget::item:selected,
QTableWidget::item:selected {
    background-color: #344f65;
    color: #ffffff;
}

QTreeWidget::indicator:indeterminate {
    width: 13px;
    height: 13px;

    background-color: #2b3d4d;
    border: 1px solid #56616e;
    border-radius: 2px;

    image: url(resources/icons/checkbox-partial.svg);
}

QCheckBox#headerCheckBox::indicator:indeterminate {
    width: 13px;
    height: 13px;

    background-color: #2b3d4d;
    border: 1px solid #56616e;
    border-radius: 2px;

    image: url(resources/icons/checkbox-partial.svg);
}

QCheckBox#dstMasterCheckbox::indicator:indeterminate {
    width: 13px;
    height: 13px;

    background-color: #2b3d4d;
    border: 1px solid #56616e;
    border-radius: 2px;

    image: url(resources/icons/checkbox-partial.svg);
}

/* ==============================
   Table headers
   ============================== */

QHeaderView::section {
    background-color: #252b32;
    color: #aeb7c2;

    border: none;
    border-right: 1px solid #343c46;
    border-bottom: 1px solid #343c46;

    padding: 6px 8px;
}

QHeaderView::section:hover {
    background-color: #2d343d;
}

/* ==============================
   Scrollbars
   ============================== */

QScrollBar:vertical {
    background-color: #181c21;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #3a424c;
    min-height: 28px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4a5562;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}


QScrollBar:horizontal {
    background-color: #181c21;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #3a424c;
    min-width: 28px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4a5562;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ==============================
   Sidebar
   ============================== */

QWidget#sideMenu {
    background-color: #171b20;

    border-right: 1px solid #30363d;
}

QWidget#sideMenu QPushButton#exitButton {
    text-align: center;
}

QWidget#sideMenu QPushButton {
    background-color: transparent;
    color: #aeb7c2;

    border: 1px solid transparent;
    border-radius: 3px;

    text-align: left;

    padding: 8px 12px;
}

QWidget#sideMenu QPushButton:hover {
    background-color: #252b32;
    color: #ffffff;

    border-color: #343c46;
}

QWidget#sideMenu QPushButton:pressed {
    background-color: #1f252b;
}

QWidget#sideMenu QPushButton:checked {
    background-color: #2b3d4d;
    color: #ffffff;

    border-color: #466781;
}


/* ==============================
   Checkboxes / radio buttons
   ============================== */

QCheckBox,
QRadioButton {
    background-color: transparent;
    color: #d7dce2;
    spacing: 8px;
}

QCheckBox::indicator:unchecked {
    background-color: #20262d;
    border: 1px solid #56616e;
    border-radius: 2px;
}

QCheckBox::indicator:unchecked:hover {
    background-color: #252c34;
    border-color: #687583;
}

QRadioButton::indicator:unchecked {
    background-color: #20262d;
    border: 1px solid #56616e;
    border-radius: 7px;
}

QRadioButton::indicator:unchecked:hover {
    background-color: #252c34;
    border-color: #687583;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: #68717b;
}

/* ==============================
   Progress bars
   ============================== */

QProgressBar {
    background-color: #181c21;
    color: #d7dce2;

    border: 1px solid #343c46;
    border-radius: 3px;

    min-height: 18px;

    text-align: center;
}

QProgressBar::chunk {
    background-color: #466781;
    border-radius: 2px;
}


/* ==============================
   Font
   ============================== */

QGroupBox::title {
    font-size: 13px;
    font-weight: 600;
}

QWidget#sideMenu QPushButton {
    font-size: 13px;
    font-weight: 500;
}

/* ==============================
   Message boxes
   ============================== */

QMessageBox QLabel {
    min-width: 360px;
    qproperty-alignment: AlignLeft | AlignVCenter;
}


